PORT=3000
DATABASE_URL="file:./prisma/dev.db"

# Version de Graph API para WhatsApp Cloud API
WHATSAPP_API_VERSION="v20.0"

# Token de acceso permanente del System User en Meta
WHATSAPP_TOKEN="EAA..."

# Phone Number ID del numero de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# Token que tu defines y luego configuras tambien en el webhook de Meta
WHATSAPP_VERIFY_TOKEN="un_token_secreto_para_webhook"